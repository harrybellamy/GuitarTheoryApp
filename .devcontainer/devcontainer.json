{
  "name": "React Guitar App Dev",
  "build": {
    "dockerfile": "dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [
    5173
  ], // Vite default
  "postCreateCommand": "npm install",
  "remoteUser": "node",
  "mounts": [
    "type=volume,source=${localWorkspaceFolder}/guitar-node-modules,target=/workspace/node_modules,type=bind,consistency=cached"
  ]
}